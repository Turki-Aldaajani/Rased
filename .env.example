# ---------------------------------------------------------------
# Rased — environment configuration
# Copy this file to .env.local and fill in what you have.
# The app runs WITHOUT any keys (heuristic offline mode), but the
# AI evaluation + real web verification need an Anthropic key.
# ---------------------------------------------------------------

# --- Storage provider ---
# Where the database lives. The whole app is one JSON document, so this only
# decides who holds the bytes.
# postgres -> one jsonb row in Postgres (Neon, Supabase, any Postgres). The only
#             backend with a real cross-instance lock, so two submissions landing
#             at the same moment cannot overwrite each other. Needs DATABASE_URL.
# netlify  -> Netlify Blobs. Only works when deployed to Netlify (or under
#             `netlify dev`), and has no lock: concurrent writes can clobber.
# Left empty: postgres when DATABASE_URL is set, netlify otherwise.
STORAGE_PROVIDER=

# --- Postgres (only when STORAGE_PROVIDER=postgres) ---
# Use the POOLED connection string, not the direct one — serverless functions
# open a connection per invocation and will exhaust a direct endpoint.
#   Neon     : the "Pooled connection" string (host ends in -pooler)
#   Supabase : Connection pooling / Transaction mode, port 6543
DATABASE_URL=
# TLS handling. Empty is right for hosted Postgres (verified TLS) and for a
# local database (no TLS). Override only if you must: disable | no-verify | require
POSTGRES_SSL=

# --- AI provider ---
# Which model reads the link and evaluates it.
# claude   -> Anthropic (default). Verifies the link itself with the
#             server-side web_search/web_fetch tools.
# deepseek -> DeepSeek (OpenAI-compatible). Has NO browsing: the app fetches
#             the page and passes the text in, so PDFs and pages that only
#             render with JavaScript come back as a clear error instead of an
#             evaluation. Needs DEEPSEEK_API_KEY.
AI_PROVIDER=claude

# --- DeepSeek (only when AI_PROVIDER=deepseek) ---
DEEPSEEK_API_KEY=
# deepseek-chat (fast, cheap — the default) or deepseek-reasoner.
DEEPSEEK_MODEL=deepseek-chat
# Override only for a proxy or a self-hosted gateway.
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# --- AI evaluator (server-side only, never exposed to the browser) ---
ANTHROPIC_API_KEY=
# Model used for verification + evaluation.
RASED_MODEL=claude-opus-5
# Model that names a pasted link (short, low-effort call). Defaults to RASED_MODEL's default.
RASED_TITLE_MODEL=claude-opus-5
# low | medium | high | xhigh | max
RASED_EFFORT=medium

# --- Web search provider ---
# anthropic  -> use Claude's built-in server-side web_search/web_fetch tools (recommended, no extra key)
# tavily     -> https://tavily.com          (needs TAVILY_API_KEY)
# brave      -> https://brave.com/search/api (needs BRAVE_API_KEY)
# serper     -> https://serper.dev          (needs SERPER_API_KEY)
# none       -> skip web search, only fetch the submitted URL
WEB_SEARCH_PROVIDER=anthropic
TAVILY_API_KEY=
BRAVE_API_KEY=
SERPER_API_KEY=

# --- Admin ---
# Passcode for the /admin page. Change it before sharing the app.
ADMIN_PASSCODE=rased

# --- Team ---
# Comma-separated roster used to seed the team on first run. Leave empty to use
# the built-in default names; members can also be managed from /admin.
RASED_TEAM=

# --- Newsletter publishing ---
# Approved issues are written to docs/newsletter/NN/, which GitHub Pages serves.
# github     -> commit through the GitHub API (what the deployed app needs)
# filesystem -> write into the local checkout (development)
# Left empty: github when a token is set, filesystem when running locally.
NEWSLETTER_PUBLISH_TARGET=
# Token with content write access on the repository below.
NEWSLETTER_GITHUB_TOKEN=
NEWSLETTER_GITHUB_REPO=Turki-Aldaajani/Rased
NEWSLETTER_GITHUB_BRANCH=main
NEWSLETTER_GITHUB_DIR=docs/newsletter
# Where the filesystem target writes. Defaults to ./docs/newsletter
NEWSLETTER_PUBLISH_DIR=

# Effort for newsletter writing only. Defaults to RASED_EFFORT.
RASED_NEWSLETTER_EFFORT=

# --- Data migration (scripts/migrate-store.mjs only, never needed at runtime) ---
# Put these (and DATABASE_URL) in .env.migrate, not .env.local: that file is git-ignored
# and Next never loads it. A DATABASE_URL in .env.local would make `next dev` write to it.
# Credentials for reading the production Netlify blob when moving to Postgres.
# Netlify -> User settings -> Applications -> Personal access tokens
NETLIFY_AUTH_TOKEN=
# Netlify -> Site configuration -> Site information -> Site ID
NETLIFY_SITE_ID=
